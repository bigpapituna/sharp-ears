# Copy to secrets.properties (gitignored) on the build PC. Never commit the real file, never paste the key in chat.
# The key is baked into the APK you build; set a credit limit on it at OpenRouter and turn logging off there.
AI_KEY=
AI_MODEL=anthropic/claude-haiku-5.5
AI_BASE_URL=https://openrouter.ai/api/v1
EMAIL_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=The pup at Sharp Ears
EMAIL_BASE_URL=https://api.brevo.com/v3
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
DIARY_TO=
# The debug routes' key: run .\scripts\set-debug-key.ps1 rather than typing one (24 random characters, never printed).
# Set, the debug build takes --es screen ... and the other debug extras only through .\scripts\adb-route.ps1.
DEBUG_ROUTE_KEY=
