<?xml version="1.0" encoding="utf-8"?>
<!--
    What Android's own backup (Android 12+: Google cloud backup and phone-to-phone transfer) may copy. Settings and
    progress go along; the GitHub report token (data/Reporter.kt), the practice recordings and stuck-moment clips
    (files/recordings since 2.10.1, the external fixtures and stalls folders before: data/Recordings.kt) never leave the
    phone (the privacy page promises that), and the Kokoro model (over 100 MB, installed by script) would push the app
    past the 25 MB cloud quota, which stops its whole backup. A phone-to-phone transfer has no quota, so the model goes
    along. The AI brief's quota and reply cache (ai-brief.xml)
    stay home either way, and so do the email brief's settings (email.xml: the grown-ups' addresses, data/EmailSettings.kt).
    The tester switches, device id and log (tester.xml, files/tester, analytics/Tester.kt) stay on this phone too.
    Keep the cloud rules the same as backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="reports.xml" />
        <exclude domain="sharedpref" path="ai-brief.xml" />
        <exclude domain="sharedpref" path="email.xml" />
        <exclude domain="sharedpref" path="tester.xml" />
        <exclude domain="file" path="tester" />
        <exclude domain="external" path="fixtures" />
        <exclude domain="external" path="stalls" />
        <exclude domain="file" path="recordings" />
        <exclude domain="file" path="kokoro" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="reports.xml" />
        <exclude domain="sharedpref" path="ai-brief.xml" />
        <exclude domain="sharedpref" path="email.xml" />
        <exclude domain="sharedpref" path="tester.xml" />
        <exclude domain="file" path="tester" />
        <exclude domain="external" path="fixtures" />
        <exclude domain="external" path="stalls" />
        <exclude domain="file" path="recordings" />
    </device-transfer>
</data-extraction-rules>
