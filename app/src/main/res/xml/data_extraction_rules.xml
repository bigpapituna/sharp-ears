<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and up: cloud backup and device-to-device transfer. Progress goes along; the report token
    (data/Reporter.kt) and the saved practice clips (files/stalls) never leave the phone. Same as backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="reports.xml" />
        <exclude domain="external" path="stalls" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="reports.xml" />
        <exclude domain="external" path="stalls" />
    </device-transfer>
</data-extraction-rules>
