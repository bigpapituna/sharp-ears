<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up: what the phone's own backup and a move to a new phone may carry. Progress, settings and imported
     songs go; the report token, the mic recordings and the 155 MB voice model (which alone broke the 25 MB backup) stay. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="reports.xml" />
        <exclude domain="file" path="kokoro/" />
        <exclude domain="external" path="stalls/" />
        <exclude domain="external" path="fixtures/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="reports.xml" />
        <exclude domain="file" path="kokoro/" />
        <exclude domain="external" path="stalls/" />
        <exclude domain="external" path="fixtures/" />
    </device-transfer>
</data-extraction-rules>
