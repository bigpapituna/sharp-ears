<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9 to 11 backup. Progress backs up as before; the report token (data/Reporter.kt) and the saved practice
    clips (files/stalls, up to 250 MB of the family's audio, over the 25 MB backup limit) never leave the phone.
    Android 12 and up read data_extraction_rules.xml; keep the two the same.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="reports.xml" />
    <exclude domain="external" path="stalls" />
</full-backup-content>
